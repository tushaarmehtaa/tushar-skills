+#!/usr/bin/env python3
+"""List pull requests merged since a date, as JSON, for drafting release notes.
+
+Usage: collect_prs.py [--since YYYY-MM-DD] [--repo PATH] [--source auto|gh|git]
+
+--since defaults to the date of the newest release-notes/YYYY-MM-DD.md in the
+repo, or the previous Friday if none exists. Prefers the GitHub CLI (which has
+labels); falls back to local merge commits, where labels are unavailable.
+"""
+import argparse
+import datetime as dt
+import json
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+NOTE_RE = re.compile(r"^(\d{4}-\d{2}-\d{2})\.md$")
+MERGE_PR_RE = re.compile(r"Merge pull request #(\d+)")
+SQUASH_PR_RE = re.compile(r"\(#(\d+)\)\s*$")
+
+
+def run(cmd, cwd):
+    return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, check=True).stdout
+
+
+def default_since(repo: Path, today: dt.date):
+    notes = repo / "release-notes"
+    dates = sorted(m.group(1) for p in notes.glob("*.md") if (m := NOTE_RE.match(p.name))) if notes.is_dir() else []
+    # Ignore today's note so a re-run covers the same range instead of an empty one.
+    dates = [d for d in dates if d != today.isoformat()]
+    if dates:
+        return dates[-1], f"latest note release-notes/{dates[-1]}.md"
+    back = (today.weekday() - 4) % 7 or 7  # previous Friday, never today
+    return (today - dt.timedelta(days=back)).isoformat(), "previous Friday (no earlier notes found)"
+
+
+def from_gh(repo: Path, since: str):
+    out = run(["gh", "pr", "list", "--state", "merged", "--limit", "200",
+               "--search", f"merged:>={since}",
+               "--json", "number,title,labels,mergedAt,files,body"], repo)
+    prs = []
+    for pr in json.loads(out):
+        prs.append({
+            "number": pr["number"],
+            "title": pr["title"],
+            "labels": [l["name"] for l in pr.get("labels", [])],
+            "merged_at": pr.get("mergedAt"),
+            "files": [f["path"] for f in pr.get("files", [])],
+            "body": (pr.get("body") or "")[:1500],
+        })
+    return sorted(prs, key=lambda p: p["merged_at"] or "")
+
+
+def from_git(repo: Path, since: str):
+    # Merge commits (true merges) plus squash merges whose subject ends in "(#123)".
+    log = run(["git", "log", "--first-parent", f"--since={since} 00:00",
+               "--format=%H%x1f%P%x1f%cI%x1f%s%x1f%b%x1e"], repo)
+    prs = []
+    for rec in filter(None, (r.strip("\n") for r in log.split("\x1e"))):
+        sha, parents, date, subject, body = (rec.split("\x1f") + [""] * 5)[:5]
+        parents = parents.split()
+        m = MERGE_PR_RE.search(subject)
+        if m and len(parents) > 1:
+            number = int(m.group(1))
+            title = next((l.strip() for l in body.splitlines() if l.strip()), subject)
+            base = parents[0]
+        elif (m := SQUASH_PR_RE.search(subject)) and parents:
+            number = int(m.group(1))
+            title = SQUASH_PR_RE.sub("", subject).strip()
+            base = parents[0]
+        else:
+            continue
+        files = run(["git", "diff", "--name-only", base, sha], repo).split()
+        prs.append({"number": number, "title": title, "labels": None,
+                    "merged_at": date, "files": files, "body": body[:1500]})
+    return sorted(prs, key=lambda p: p["merged_at"])
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("--since", help="YYYY-MM-DD, inclusive")
+    ap.add_argument("--repo", default=".")
+    ap.add_argument("--source", choices=["auto", "gh", "git"], default="auto")
+    args = ap.parse_args()
+
+    repo = Path(args.repo).resolve()
+    try:
+        run(["git", "rev-parse", "--git-dir"], repo)
+    except (subprocess.CalledProcessError, FileNotFoundError):
+        sys.exit(f"error: {repo} is not a git repository")
+
+    if args.since:
+        try:
+            dt.date.fromisoformat(args.since)
+        except ValueError:
+            sys.exit(f"error: --since must be YYYY-MM-DD, got {args.since!r}")
+        since, reason = args.since, "--since argument"
+    else:
+        since, reason = default_since(repo, dt.date.today())
+
+    source, warning, prs = None, None, None
+    if args.source in ("auto", "gh"):
+        try:
+            prs, source = from_gh(repo, since), "gh"
+        except (subprocess.CalledProcessError, FileNotFoundError) as e:
+            detail = getattr(e, "stderr", "") or str(e)
+            if args.source == "gh":
+                sys.exit(f"error: gh failed: {detail.strip()}")
+            warning = f"gh unavailable ({detail.strip().splitlines()[0] if detail.strip() else 'unknown error'}); labels not available, used git merge commits"
+    if prs is None:
+        prs, source = from_git(repo, since), "git"
+
+    json.dump({"since": since, "since_reason": reason, "source": source,
+               "warning": warning, "count": len(prs), "prs": prs}, sys.stdout, indent=2)
+    print()
+
+
+if __name__ == "__main__":
+    main()
