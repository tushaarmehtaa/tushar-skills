index 0000000..e6411c9
--- /dev/null
+++ b/lib/ledger.js
@@ -0,0 +1,77 @@
+// Money is held in paise (integers) so splits and balances never drift.
+
+const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
+const WEEKDAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
+
+export function toPaise(rupees) {
+  return Math.round(Number(rupees) * 100);
+}
+
+export function formatINR(paise) {
+  const abs = Math.abs(paise);
+  const digits = abs % 100 === 0 ? 0 : 2;
+  return "₹" + (abs / 100).toLocaleString("en-IN", { minimumFractionDigits: digits, maximumFractionDigits: 2 });
+}
+
+// "2026-10-01" -> "Thu 1 Oct". Parsed as UTC so server and browser agree.
+export function formatDay(iso) {
+  const [y, m, d] = iso.split("-").map(Number);
+  const weekday = new Date(Date.UTC(y, m - 1, d)).getUTCDay();
+  return `${WEEKDAYS[weekday]} ${d} ${MONTHS[m - 1]}`;
+}
+
+export function todayISO() {
+  const d = new Date();
+  const pad = (n) => String(n).padStart(2, "0");
+  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
+}
+
+// Equal split; leftover paise go to the first people listed so shares sum exactly.
+export function shares(expense) {
+  const n = expense.splitBetween.length;
+  const base = Math.floor(expense.amount / n);
+  const extra = expense.amount - base * n;
+  return Object.fromEntries(expense.splitBetween.map((m, i) => [m, base + (i < extra ? 1 : 0)]));
+}
+
+export function shareOf(expense, member) {
+  return shares(expense)[member] ?? 0;
+}
+
+// Positive: the flat owes this person. Negative: this person owes the flat.
+export function balances(members, expenses, settlements) {
+  const net = Object.fromEntries(members.map((m) => [m, 0]));
+  for (const e of expenses) {
+    net[e.paidBy] += e.amount;
+    for (const [m, share] of Object.entries(shares(e))) net[m] -= share;
+  }
+  for (const s of settlements) {
+    net[s.from] += s.amount;
+    net[s.to] -= s.amount;
+  }
+  return net;
+}
+
+// Fewest payments that clear every balance: repeatedly match the largest debtor with the largest creditor.
+export function simplify(net) {
+  const debtors = [];
+  const creditors = [];
+  for (const [m, v] of Object.entries(net)) {
+    if (v < 0) debtors.push({ m, v: -v });
+    else if (v > 0) creditors.push({ m, v });
+  }
+  const transfers = [];
+  while (debtors.length && creditors.length) {
+    debtors.sort((a, b) => b.v - a.v);
+    creditors.sort((a, b) => b.v - a.v);
+    const d = debtors[0];
+    const c = creditors[0];
+    const amount = Math.min(d.v, c.v);
+    transfers.push({ from: d.m, to: c.m, amount });
+    d.v -= amount;
+    c.v -= amount;
+    if (d.v === 0) debtors.shift();
+    if (c.v === 0) creditors.shift();
+  }
+  return transfers;
+}
