+/* Flat home (dashboard) */
+.dash {
+  --ink: #1a1a2e;
+  --ink-2: #4b5563;
+  --ink-3: #6b7280;
+  --line: #e5e7eb;
+  --surface: #fff;
+  --surface-2: #f8f7fb;
+  --accent: #764ba2;
+  --accent-hover: #643e8b;
+  --accent-soft: #f5f3ff;
+  --owe: #b45309;
+  --owed: #047857;
+  --danger: #b91c1c;
+  --radius: 12px;
+  --radius-sm: 8px;
+  --ease: 160ms ease-out;
+
+  max-width: 1100px;
+  margin: 0 auto;
+  padding: 32px 24px 96px; /* bottom room for the support chat button */
+  color: var(--ink);
+}
+.dash h1 { margin: 0; font-size: 28px; line-height: 1.2; }
+.dash h2 { margin: 0; font-size: 17px; }
+.dash-num, .dash-amount { font-variant-numeric: tabular-nums; }
+.dash-meta { margin: 2px 0 0; color: var(--ink-3); font-size: 14px; }
+.dash-muted { color: var(--ink-3); }
+.dash-hint { margin: 12px 0 0; color: var(--ink-3); font-size: 13px; }
+.is-owe { color: var(--owe); }
+.is-owed { color: var(--owed); }
+.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+
+.dash-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
+.dash-fixture { margin: 12px 0 0; font-size: 13px; color: var(--ink-2); }
+
+.dash-btn {
+  min-height: 40px; padding: 8px 14px; border-radius: var(--radius-sm);
+  border: 1px solid var(--line); background: var(--surface); color: var(--ink);
+  font: inherit; font-size: 14px; font-weight: 600; cursor: pointer; white-space: nowrap;
+  transition: background-color var(--ease), border-color var(--ease);
+}
+.dash-btn:hover { border-color: var(--accent); background: var(--accent-soft); }
+.dash-btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
+.dash-btn-primary:hover { background: var(--accent-hover); border-color: var(--accent-hover); }
+.dash-link {
+  min-height: 32px; padding: 4px 6px; border: 0; background: none;
+  font: inherit; font-size: 14px; font-weight: 600; color: var(--accent); cursor: pointer;
+  text-decoration: underline; text-underline-offset: 3px;
+}
+.dash :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+
+.dash-notice { display: flex; align-items: center; gap: 12px; margin-top: 24px; font-size: 14px; }
+.dash-notice:not(:empty) { min-height: 44px; margin-bottom: 20px; padding: 6px 8px 6px 14px; border-radius: var(--radius-sm); background: var(--accent-soft); }
+
+.dash-grid {
+  display: grid; gap: 20px;
+  grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
+  grid-template-areas: "you balances" "settle balances" "activity activity";
+}
+.dash-you { grid-area: you; }
+.dash-settle { grid-area: settle; }
+.dash-balances { grid-area: balances; align-self: start; }
+.dash-activity { grid-area: activity; }
+
+.dash-panel { border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); padding: 20px; }
+.dash-panel-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
+.dash-panel-head .dash-meta { margin: 0; }
+.dash-empty { margin: 8px 0 0; color: var(--ink-2); }
+.dash-list { list-style: none; margin: 0; padding: 0; }
+.dash-list > li + li { border-top: 1px solid var(--line); }
+
+.dash-you { padding: 20px; border-radius: var(--radius); background: var(--surface-2); }
+.dash .dash-eyebrow { color: var(--ink-3); font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; }
+.dash-you-figure { margin: 6px 0 0; font-size: 32px; font-weight: 700; line-height: 1.2; }
+.dash-you-steps { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 20px; color: var(--ink-2); }
+
+.dash-transfer { display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 16px; padding: 12px 0; }
+.dash-transfer-who { display: flex; align-items: center; gap: 8px; min-width: 0; }
+.dash-arrow { color: var(--ink-3); }
+.dash-transfer .dash-amount { font-weight: 600; }
+
+.dash-balance { display: flex; justify-content: space-between; gap: 12px; padding: 10px 0; }
+.dash-you-tag { color: var(--ink-3); }
+
+.dash-day + .dash-day { margin-top: 16px; }
+.dash-day-label { margin: 0 0 2px; padding: 6px 0; font-size: 13px; font-weight: 600; color: var(--ink-3); border-bottom: 1px solid var(--line); }
+.dash-entry { display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 16px; padding: 10px 0; }
+.dash-day .dash-list > li:first-child { border-top: 0; }
+.dash-entry-main { display: flex; flex-direction: column; min-width: 0; }
+.dash-entry-title { overflow-wrap: anywhere; }
+.dash-entry-main .dash-meta { margin: 0; font-size: 13px; }
+.dash-entry-side { display: flex; flex-direction: column; align-items: flex-end; text-align: right; }
+.dash-entry-side .dash-amount { font-weight: 600; }
+.dash-effect { font-size: 13px; }
+.dash-entry:not(:has(.dash-delete)) { grid-template-columns: 1fr auto; }
+.dash-delete { color: var(--ink-3); font-weight: 500; }
+.dash-delete:hover { color: var(--danger); }
+.dash-more { margin-top: 12px; }
+
+.dash-dialog {
+  width: min(480px, calc(100vw - 32px)); max-height: calc(100dvh - 32px);
+  padding: 0; border: 0; border-radius: var(--radius); color: var(--ink);
+  box-shadow: 0 20px 50px rgba(26, 26, 46, 0.25);
+}
+.dash-dialog::backdrop { background: rgba(26, 26, 46, 0.4); }
+.dash-dialog[open] { animation: dash-in 160ms ease-out; }
+@keyframes dash-in { from { opacity: 0; transform: translateY(8px); } }
+.dash-form { display: flex; flex-direction: column; gap: 16px; padding: 24px; }
+.dash-form h2 { font-size: 20px; }
+.dash-field { display: flex; flex-direction: column; gap: 6px; margin: 0; padding: 0; border: 0; min-width: 0; font-size: 14px; font-weight: 600; }
+.dash-field legend { padding: 0; margin-bottom: 6px; }
+.dash-field input, .dash-field select {
+  min-height: 42px; padding: 8px 10px; border: 1px solid #c9ccd3; border-radius: var(--radius-sm);
+  font: inherit; font-weight: 400; color: var(--ink); background: var(--surface); width: 100%;
+}
+.dash-field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
+.dash-checks { display: flex; flex-wrap: wrap; gap: 4px 16px; }
+.dash-check { display: flex; align-items: center; gap: 8px; min-height: 36px; font-weight: 400; }
+.dash-check input { width: 18px; height: 18px; accent-color: var(--accent); }
+.dash-field .dash-hint, .dash-error { margin: 2px 0 0; font-weight: 400; }
+.dash-error { color: var(--danger); font-size: 13px; }
+.dash-form-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 4px; }
+
+@media (max-width: 760px) {
+  .dash { padding-top: 24px; }
+  .dash h1 { font-size: 24px; }
+  .dash-grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: "you" "settle" "balances" "activity"; gap: 16px; }
+  .dash-panel { padding: 16px; }
+  .dash-you-figure { font-size: 28px; }
+  .dash-transfer { grid-template-columns: 1fr auto; }
+  .dash-transfer .dash-btn { grid-column: 1 / -1; width: 100%; }
+  .dash-entry { grid-template-columns: 1fr auto; gap: 4px 12px; }
+  .dash-delete { grid-column: 2; justify-self: end; }
+  .dash-field-row { grid-template-columns: 1fr; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .dash-dialog[open] { animation: none; }
+  .dash-btn { transition: none; }
+}
+
+.topnav { display: flex; align-items: center; gap: 32px; padding: 16px 32px; border-bottom: 1px solid #ede9fe; white-space: nowrap; overflow-x: auto; }
 .logo { font-weight: 800; font-size: 20px; text-decoration: none; }
 .links { display: flex; gap: 28px; }
 .links a { font-size: 13px; text-decoration: none; padding: 2px 0; color: #4b5563; }
