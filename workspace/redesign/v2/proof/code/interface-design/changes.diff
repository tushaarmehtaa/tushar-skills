diff --git a/app/dashboard/FlatHome.jsx b/app/dashboard/FlatHome.jsx
new file mode 100644
index 0000000..17fabb6
--- /dev/null
+++ b/app/dashboard/FlatHome.jsx
@@ -0,0 +1,407 @@
+"use client";
+import { useEffect, useMemo, useRef, useState } from "react";
+import { balances, simplify, shareOf, formatINR, formatDay, todayISO, toPaise } from "../../lib/ledger";
+
+const ACTIVITY_PREVIEW = 8;
+
+export default function FlatHome({ name, members, you, initialExpenses, initialSettlements }) {
+  const [expenses, setExpenses] = useState(initialExpenses);
+  const [settlements, setSettlements] = useState(initialSettlements);
+  const [notice, setNotice] = useState(null);
+  const [showAllActivity, setShowAllActivity] = useState(false);
+  const dialogRef = useRef(null);
+  const undoRef = useRef(null);
+  const noticeRef = useRef(null);
+
+  const net = useMemo(() => balances(members, expenses, settlements), [members, expenses, settlements]);
+  const transfers = useMemo(() => simplify(net), [net]);
+  const outstanding = transfers.reduce((sum, t) => sum + t.amount, 0);
+  const yours = transfers.filter((t) => t.from === you || t.to === you);
+  const others = transfers.filter((t) => t.from !== you && t.to !== you);
+
+  const activity = useMemo(() => {
+    const items = [
+      ...expenses.map((e) => ({ ...e, kind: "expense" })),
+      ...settlements.map((s) => ({ ...s, kind: "payment" })),
+    ];
+    return items.sort((a, b) => b.date.localeCompare(a.date) || (b.seq ?? 0) - (a.seq ?? 0));
+  }, [expenses, settlements]);
+  const visibleActivity = showAllActivity ? activity : activity.slice(0, ACTIVITY_PREVIEW);
+
+  useEffect(() => {
+    if (notice?.undo) undoRef.current?.focus();
+    else if (notice) noticeRef.current?.focus();
+  }, [notice]);
+
+  const label = (m) => (m === you ? "You" : m);
+  const who = (m) => (m === you ? "you" : m);
+
+  function recordPayment(t) {
+    const payment = { ...t, id: `s${Date.now()}`, date: todayISO(), seq: Date.now() };
+    setSettlements((prev) => [...prev, payment]);
+    setNotice({
+      message: `Recorded ${formatINR(t.amount)} from ${who(t.from)} to ${who(t.to)}.`,
+      undo: () => setSettlements((prev) => prev.filter((s) => s.id !== payment.id)),
+      undone: "Payment removed.",
+    });
+  }
+
+  function deleteExpense(expense) {
+    setExpenses((prev) => prev.filter((e) => e.id !== expense.id));
+    setNotice({
+      message: `Deleted “${expense.what}”.`,
+      undo: () => setExpenses((prev) => [...prev, expense]),
+      undone: `Restored “${expense.what}”.`,
+    });
+  }
+
+  function addExpense(expense) {
+    setExpenses((prev) => [...prev, expense]);
+    setNotice({
+      message: `Added “${expense.what}”, ${formatINR(expense.amount)} split ${expense.splitBetween.length} ways.`,
+      undo: () => setExpenses((prev) => prev.filter((e) => e.id !== expense.id)),
+      undone: `Removed “${expense.what}”.`,
+    });
+  }
+
+  return (
+    <main className="dash">
+      <header className="dash-head">
+        <div>
+          <h1>{name}</h1>
+          <p className="dash-meta">
+            {members.length} members · {members.join(", ")}
+          </p>
+        </div>
+        <button type="button" className="dash-btn dash-btn-primary" onClick={() => dialogRef.current?.open()}>
+          Add expense
+        </button>
+      </header>
+      <p className="dash-fixture">Sample data — viewing as {you}. Changes last until you reload.</p>
+
+      <div ref={noticeRef} className="dash-notice" role="status" aria-live="polite" tabIndex={-1}>
+        {notice && (
+          <>
+            <span>{notice.message}</span>
+            {notice.undo && (
+              <button
+                ref={undoRef}
+                type="button"
+                className="dash-link"
+                onClick={() => {
+                  notice.undo();
+                  setNotice({ message: notice.undone });
+                }}
+              >
+                Undo
+              </button>
+            )}
+          </>
+        )}
+      </div>
+
+      <div className="dash-grid">
+        <section className="dash-you" aria-labelledby="you-heading">
+          <h2 id="you-heading" className="dash-eyebrow">Your position</h2>
+          <YourPosition net={net[you]} transfers={yours} you={you} />
+        </section>
+
+        <section className="dash-panel dash-settle" aria-labelledby="settle-heading">
+          <div className="dash-panel-head">
+            <h2 id="settle-heading">To settle</h2>
+            {transfers.length > 0 && (
+              <p className="dash-meta">
+                {formatINR(outstanding)} in {transfers.length} {transfers.length === 1 ? "payment" : "payments"}
+              </p>
+            )}
+          </div>
+          {transfers.length === 0 ? (
+            <p className="dash-empty">Everyone’s square. Nothing to settle.</p>
+          ) : (
+            <>
+              <ul className="dash-list">
+                {[...yours, ...others].map((t) => (
+                  <li key={`${t.from}-${t.to}`} className="dash-transfer">
+                    <span className="dash-transfer-who">
+                      <strong>{label(t.from)}</strong>
+                      <span className="dash-arrow" aria-hidden="true">→</span>
+                      <span className="sr-only">{t.from === you ? "pay" : "pays"}</span>
+                      <strong>{who(t.to)}</strong>
+                    </span>
+                    <span className="dash-amount">{formatINR(t.amount)}</span>
+                    <button
+                      type="button"
+                      className="dash-btn"
+                      onClick={() => recordPayment(t)}
+                      aria-label={`Record ${formatINR(t.amount)} paid by ${who(t.from)} to ${who(t.to)}`}
+                    >
+                      Record payment
+                    </button>
+                  </li>
+                ))}
+              </ul>
+              <p className="dash-hint">
+                Balances are combined so the flat makes the fewest payments. Record a payment once the money has moved.
+              </p>
+            </>
+          )}
+        </section>
+
+        <section className="dash-panel dash-balances" aria-labelledby="balances-heading">
+          <div className="dash-panel-head">
+            <h2 id="balances-heading">Balances</h2>
+          </div>
+          <ul className="dash-list">
+            {members.map((m) => (
+              <li key={m} className="dash-balance">
+                <span>
+                  {m}
+                  {m === you && <span className="dash-you-tag"> (you)</span>}
+                </span>
+                <BalanceText value={net[m]} />
+              </li>
+            ))}
+          </ul>
+        </section>
+
+        <section className="dash-panel dash-activity" aria-labelledby="activity-heading">
+          <div className="dash-panel-head">
+            <h2 id="activity-heading">Recent activity</h2>
+          </div>
+          {activity.length === 0 ? (
+            <p className="dash-empty">
+              No expenses yet. Add the first one and Tallyroom will work out who owes what.
+            </p>
+          ) : (
+            <>
+              <ActivityList items={visibleActivity} you={you} label={label} onDelete={deleteExpense} />
+              {activity.length > ACTIVITY_PREVIEW && (
+                <button type="button" className="dash-link dash-more" onClick={() => setShowAllActivity((v) => !v)}>
+                  {showAllActivity ? "Show recent only" : `Show all ${activity.length} entries`}
+                </button>
+              )}
+            </>
+          )}
+        </section>
+      </div>
+
+      <AddExpenseDialog ref={dialogRef} members={members} you={you} onAdd={addExpense} />
+    </main>
+  );
+}
+
+function YourPosition({ net, transfers, you }) {
+  if (net === 0) {
+    return (
+      <>
+        <p className="dash-you-figure">You’re settled up</p>
+        <p className="dash-meta">Nobody owes you and you don’t owe anyone.</p>
+      </>
+    );
+  }
+  const owing = net < 0;
+  return (
+    <>
+      <p className={`dash-you-figure ${owing ? "is-owe" : "is-owed"}`}>
+        {owing ? "You owe " : "You’re owed "}
+        <span className="dash-num">{formatINR(net)}</span>
+      </p>
+      <ul className="dash-you-steps">
+        {transfers.map((t) => (
+          <li key={`${t.from}-${t.to}`}>
+            {t.from === you ? `Pay ${t.to}` : `${t.from} pays you`}{" "}
+            <span className="dash-num">{formatINR(t.amount)}</span>
+          </li>
+        ))}
+      </ul>
+    </>
+  );
+}
+
+function BalanceText({ value }) {
+  if (value === 0) return <span className="dash-muted">settled up</span>;
+  return value > 0 ? (
+    <span className="is-owed">
+      gets back <span className="dash-num">{formatINR(value)}</span>
+    </span>
+  ) : (
+    <span className="is-owe">
+      owes <span className="dash-num">{formatINR(value)}</span>
+    </span>
+  );
+}
+
+function ActivityList({ items, you, label, onDelete }) {
+  const groups = [];
+  for (const item of items) {
+    const last = groups[groups.length - 1];
+    if (last && last.date === item.date) last.items.push(item);
+    else groups.push({ date: item.date, items: [item] });
+  }
+  return (
+    <div className="dash-days">
+      {groups.map((g) => (
+        <div key={g.date} className="dash-day">
+          <h3 className="dash-day-label">{formatDay(g.date)}</h3>
+          <ul className="dash-list">
+            {g.items.map((item) =>
+              item.kind === "expense" ? (
+                <ExpenseRow key={item.id} expense={item} you={you} label={label} onDelete={onDelete} />
+              ) : (
+                <li key={item.id} className="dash-entry">
+                  <div className="dash-entry-main">
+                    <span className="dash-entry-title">
+                      {label(item.from)} paid {item.to === you ? "you" : item.to}
+                    </span>
+                    <span className="dash-meta">Payment</span>
+                  </div>
+                  <span className="dash-amount">{formatINR(item.amount)}</span>
+                </li>
+              )
+            )}
+          </ul>
+        </div>
+      ))}
+    </div>
+  );
+}
+
+function ExpenseRow({ expense, you, label, onDelete }) {
+  const share = shareOf(expense, you);
+  let effect;
+  if (expense.paidBy === you) {
+    const lent = expense.amount - share;
+    effect = lent > 0 ? <span className="is-owed">you lent {formatINR(lent)}</span> : <span className="dash-muted">just you</span>;
+  } else if (share > 0) {
+    effect = <span className="is-owe">your share {formatINR(share)}</span>;
+  } else {
+    effect = <span className="dash-muted">not involved</span>;
+  }
+  const n = expense.splitBetween.length;
+  const everyone = n > 1 ? `split ${n} ways` : `for ${label(expense.splitBetween[0])}`;
+
+  return (
+    <li className="dash-entry">
+      <div className="dash-entry-main">
+        <span className="dash-entry-title">{expense.what}</span>
+        <span className="dash-meta">
+          {label(expense.paidBy)} paid · {everyone}
+        </span>
+      </div>
+      <div className="dash-entry-side">
+        <span className="dash-amount">{formatINR(expense.amount)}</span>
+        <span className="dash-effect">{effect}</span>
+      </div>
+      <button
+        type="button"
+        className="dash-link dash-delete"
+        onClick={() => onDelete(expense)}
+        aria-label={`Delete ${expense.what}`}
+      >
+        Delete
+      </button>
+    </li>
+  );
+}
+
+function AddExpenseDialog({ ref, members, you, onAdd }) {
+  const dialog = useRef(null);
+  const form = useRef(null);
+  const [splitError, setSplitError] = useState(false);
+
+  // Expose open() to the parent; the native dialog handles focus trapping, Esc, and focus return.
+  useEffect(() => {
+    ref.current = {
+      open() {
+        form.current.reset();
+        const date = form.current.elements.date;
+        date.value = date.max = todayISO();
+        setSplitError(false);
+        dialog.current.showModal();
+      },
+    };
+  }, [ref]);
+
+  function submit(event) {
+    event.preventDefault();
+    const data = new FormData(event.currentTarget);
+    const splitBetween = members.filter((m) => data.getAll("split").includes(m));
+    if (splitBetween.length === 0) {
+      setSplitError(true);
+      form.current.querySelector('input[name="split"]').focus();
+      return;
+    }
+    const amount = toPaise(data.get("amount"));
+    onAdd({
+      id: `e${Date.now()}`,
+      seq: Date.now(),
+      date: data.get("date"),
+      what: data.get("what").trim(),
+      paidBy: data.get("paidBy"),
+      amount,
+      splitBetween,
+    });
+    dialog.current.close();
+  }
+
+  return (
+    <dialog ref={dialog} className="dash-dialog" aria-labelledby="add-heading">
+      <form ref={form} onSubmit={submit} className="dash-form">
+        <h2 id="add-heading">Add expense</h2>
+
+        <label className="dash-field">
+          <span>What was it for?</span>
+          <input name="what" required maxLength={80} autoComplete="off" placeholder="e.g. Groceries — BigBasket" />
+        </label>
+
+        <div className="dash-field-row">
+          <label className="dash-field">
+            <span>Amount (₹)</span>
+            <input name="amount" type="number" inputMode="decimal" min="0.01" step="0.01" required />
+          </label>
+          <label className="dash-field">
+            <span>Date</span>
+            <input name="date" type="date" required />
+          </label>
+        </div>
+
+        <label className="dash-field">
+          <span>Paid by</span>
+          <select name="paidBy" defaultValue={you}>
+            {members.map((m) => (
+              <option key={m} value={m}>
+                {m === you ? `${m} (you)` : m}
+              </option>
+            ))}
+          </select>
+        </label>
+
+        <fieldset className="dash-field" aria-describedby={splitError ? "split-error" : "split-hint"}>
+          <legend>Split equally between</legend>
+          <div className="dash-checks">
+            {members.map((m) => (
+              <label key={m} className="dash-check">
+                <input type="checkbox" name="split" value={m} defaultChecked onChange={() => setSplitError(false)} />
+                {m === you ? `${m} (you)` : m}
+              </label>
+            ))}
+          </div>
+          {splitError ? (
+            <p id="split-error" className="dash-error">Choose at least one person to split with.</p>
+          ) : (
+            <p id="split-hint" className="dash-hint">Untick anyone who wasn’t part of it.</p>
+          )}
+        </fieldset>
+
+        <div className="dash-form-actions">
+          <button type="button" className="dash-btn" onClick={() => dialog.current.close()}>
+            Cancel
+          </button>
+          <button type="submit" className="dash-btn dash-btn-primary">
+            Add expense
+          </button>
+        </div>
+      </form>
+    </dialog>
+  );
+}
