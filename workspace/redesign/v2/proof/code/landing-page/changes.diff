+// Example group shown on the dashboard mock and the homepage preview. Not customer data.
+export const exampleFlat = {
+  name: "Flat 4B — Indiranagar",
+  youOwe: 1842,
+  youAreOwed: 710,
+  expenses: [
+    { date: "Oct 1", what: "Groceries — Nature's Basket", paidBy: "Arjun", amount: 2840.5, split: "4 ways", status: "Unsettled" },
+    { date: "Sep 30", what: "Electricity bill (Sept)", paidBy: "Maya", amount: 3125, split: "4 ways", status: "Settled" },
+    { date: "Sep 28", what: "Wi-Fi — ACT Fibernet", paidBy: "Kabir", amount: 1179, split: "4 ways", status: "Unsettled" },
+    { date: "Sep 27", what: "Dinner at Toit", paidBy: "Arjun", amount: 4620, split: "3 ways", status: "Unsettled" },
+    { date: "Sep 25", what: "Cooking gas refill", paidBy: "Neha", amount: 903, split: "4 ways", status: "Settled" },
+  ],
+};
+
+export const inr = (n) => {
+  const digits = Number.isInteger(n) ? 0 : 2;
+  return "₹" + n.toLocaleString("en-IN", { minimumFractionDigits: digits, maximumFractionDigits: digits });
+};
