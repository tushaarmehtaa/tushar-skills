diff --git a/lib/og-card.jsx b/lib/og-card.jsx
new file mode 100644
index 0000000..9d35276
--- /dev/null
+++ b/lib/og-card.jsx
@@ -0,0 +1,33 @@
+import { ImageResponse } from "next/og";
+
+export const SITE_URL = "https://tallyroom.app";
+
+export const ogSize = { width: 1200, height: 630 };
+
+// Shared 1200x630 preview card, styled after the homepage hero.
+export function ogCard({ title, subtitle }) {
+  return new ImageResponse(
+    (
+      <div
+        style={{
+          width: "100%",
+          height: "100%",
+          display: "flex",
+          flexDirection: "column",
+          justifyContent: "space-between",
+          padding: 80,
+          background: "linear-gradient(135deg, #667eea 0%, #764ba2 50%, #a855f7 100%)",
+          color: "#fff",
+        }}
+      >
+        <div style={{ fontSize: 40, fontWeight: 800 }}>Tallyroom</div>
+        <div style={{ display: "flex", flexDirection: "column", gap: 24 }}>
+          <div style={{ fontSize: 76, fontWeight: 800, lineHeight: 1.05, maxWidth: 1000 }}>{title}</div>
+          <div style={{ fontSize: 34, opacity: 0.9, maxWidth: 1000 }}>{subtitle}</div>
+        </div>
+        <div style={{ fontSize: 28, opacity: 0.8 }}>tallyroom.app</div>
+      </div>
+    ),
+    ogSize,
+  );
+}
