diff --git a/app/robots.js b/app/robots.js
new file mode 100644
index 0000000..8c651b7
--- /dev/null
+++ b/app/robots.js
@@ -0,0 +1,10 @@
+import { SITE_URL } from "../lib/site";
+
+// /dashboard is kept out of the index with a noindex meta tag rather than a
+// Disallow rule, so crawlers can still fetch it and see that directive.
+export default function robots() {
+  return {
+    rules: { userAgent: "*", allow: "/" },
+    sitemap: `${SITE_URL}/sitemap.xml`,
+  };
+}
