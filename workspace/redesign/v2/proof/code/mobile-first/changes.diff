+.icon-btn { width: 32px; height: 32px; padding: 0; font-size: 15px; border-radius: 8px; border: 0; background: none; cursor: pointer; }
 
 .topnav { display: flex; align-items: center; gap: 32px; padding: 16px 32px; border-bottom: 1px solid #ede9fe; white-space: nowrap; }
 .logo { font-weight: 800; font-size: 20px; text-decoration: none; }
 .links { display: flex; gap: 28px; }
 .links a { font-size: 13px; text-decoration: none; padding: 2px 0; color: #4b5563; }
-.nav-cta { margin-left: auto; font-size: 13px; padding: 6px 12px; border-radius: 8px; background: #764ba2; color: #fff; text-decoration: none; }
+.nav-cta { margin-left: auto; font-size: 13px; padding: 8px 14px; border-radius: 8px; background: #764ba2; color: #fff; text-decoration: none; }
 
 .shot { max-width: 1100px; margin: -48px auto 0; padding: 0 24px; }
-.shot img { width: 100%; border-radius: 20px; box-shadow: 0 30px 60px rgba(0,0,0,0.15); }
+.shot img { display: block; width: 100%; height: auto; border-radius: 20px; box-shadow: 0 30px 60px rgba(0,0,0,0.15); }
 
-.plan-actions { display: flex; gap: 8px; margin-top: 24px; }
-.mini-btn { font-size: 12px; padding: 3px 8px; border-radius: 6px; background: #764ba2; color: #fff; text-decoration: none; }
+.plan-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
+.mini-btn { display: inline-flex; align-items: center; min-height: 44px; font-size: 15px; font-weight: 600; padding: 10px 18px; border-radius: 10px; background: #764ba2; color: #fff; text-decoration: none; }
 
 .faq { margin-top: 64px; max-width: 680px; }
 .faq h3 { margin: 24px 0 6px; font-size: 17px; }
 .faq p { margin: 0; color: #4b5563; }
+
+.icon-btn:hover { background: #f5f3ff; }
+
+@media (max-width: 960px) {
+  .topnav { flex-wrap: wrap; gap: 4px 12px; padding: 8px 16px; white-space: normal; }
+  .logo { flex: 1 0 auto; display: inline-flex; align-items: center; min-height: 44px; }
+  .nav-cta { display: inline-flex; align-items: center; min-height: 44px; padding: 10px 16px; font-size: 15px; }
+  .links { order: 1; flex: 1 1 100%; flex-wrap: wrap; gap: 0 4px; margin: 0 -10px; }
+  .links a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 10px; font-size: 15px; }
+  .compare th, .compare td, .ledger th, .ledger td { padding: 10px; }
+}
+
+@media (max-width: 640px) {
+  /* Room to scroll the last content clear of the fixed support-chat bubble. */
+  body { padding-bottom: calc(80px + env(safe-area-inset-bottom)); }
+  .stat { flex: 1 1 100%; max-width: none; padding: 16px 20px; }
+  .compare thead th { white-space: normal; min-width: 7em; vertical-align: bottom; }
+  .compare tbody th { white-space: normal; min-width: 8em; }
+}
+
+@media (pointer: coarse) {
+  .icon-btn { width: 44px; height: 44px; font-size: 17px; }
+}
