+.page { max-width: 1100px; margin: 0 auto; padding: clamp(28px, 6vw, 48px) 20px; }
+.table-scroll { max-width: 100%; overflow-x: auto; overscroll-behavior-x: contain; }
+.table-scroll:focus-visible { outline: 2px solid #764ba2; outline-offset: 2px; }
 .sub { color: #6b7280; }
-.compare { width: 960px; border-collapse: collapse; margin-top: 32px; }
+.compare { width: 100%; min-width: 640px; border-collapse: collapse; margin-top: 32px; }
 .compare th, .compare td { padding: 14px 18px; border-bottom: 1px solid #e5e7eb; text-align: left; white-space: nowrap; }
 .compare thead th { background: #f5f3ff; }
